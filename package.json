{
  "name": "q-monitor",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "build:portable": "tsc -b && vite build --config vite.portable.config.ts",
    "desktop": "npm run build:portable && electron .",
    "build:windows": "npm run build:portable && electron-builder --win nsis portable --x64 --publish never",
    "test:desktop": "node scripts/test-desktop.cjs",
    "build:windows:portable": "npm run build:portable && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.3.17",
    "recharts": "^3.0.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.0"
  },
  "description": "Aplicación de escritorio para captura manual y análisis de calidad industrial",
  "author": "Q-MONITOR",
  "main": "electron/main.cjs"
}
